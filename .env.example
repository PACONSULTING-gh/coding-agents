# Copia este fichero a .env y rellena con valores reales.
# Ninguno de los valores de aqui es un secreto real.

# Entorno de ejecucion: development | test | production
NODE_ENV=development

# Nivel de log de pino: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# ----------------------------------------------------------------------------
# Base de datos
#
# Hay DOS destinos distintos y no son intercambiables:
#
#   DATABASE_URL   -> Postgres DIRECTO (5432). Lo usa pg-boss, que necesita
#                     estado de sesion (LISTEN/NOTIFY), y las migraciones.
#   PGBOUNCER_URL  -> PgBouncer en modo transaccion (6432). Es por donde va
#                     TODO el acceso a datos de la aplicacion.
#
# Si PGBOUNCER_URL no esta definida, packages/db cae a DATABASE_URL avisando
# por consola: la aplicacion arranca, pero sin pooler. En produccion eso es un
# error de despliegue, no una opcion.
#
# Los roles se llaman `app_runtime` y `app_migrator`: son los que crea la
# migracion 0001 de packages/db. No los renombres aqui sin renombrarlos alli.
# ----------------------------------------------------------------------------

# Cadena de conexion Postgres DIRECTA para el usuario de RUNTIME (permisos acotados por RLS)
DATABASE_URL=postgres://app_runtime:changeme-runtime@localhost:5432/coord

# Cadena de conexion a traves de PgBouncer (modo transaccion). Es la que usa la
# capa de datos de la aplicacion.
PGBOUNCER_URL=postgres://app_runtime:changeme-runtime@localhost:6432/coord

# Cadena de conexion Postgres para el usuario de MIGRACIONES (permisos de DDL, separado del runtime)
DATABASE_MIGRATION_URL=postgres://app_migrator:changeme-migrator@localhost:5432/coord

# Cadena de conexion de ADMINISTRACION: solo se usa una vez, para el bootstrap de
# los roles (migracion 0001 de packages/db) y para asignarles contrasena.
# El usuario es el superusuario del Postgres local (POSTGRES_USER de
# infra/docker-compose.yml, por defecto `coord`).
DATABASE_ADMIN_URL=postgres://coord:changeme-postgres@localhost:5432/coord

# Credenciales del Postgres de DESARROLLO LOCAL (infra/docker-compose.yml).
# El compose las exige por variable; no hay ninguna contrasena literal en el repo.
# Puertos del HOST donde se publican los contenedores de infra/docker-compose.yml.
# Cambialos si ya tienes un Postgres del sistema ocupando el 5432. Dentro de la
# red de contenedores los puertos no cambian, asi que solo afectan a las URLs
# de conexion de arriba.
POSTGRES_HOST_PORT=5432
PGBOUNCER_HOST_PORT=6432

POSTGRES_USER=coord
POSTGRES_PASSWORD=changeme-postgres
POSTGRES_DB=coord

# Contrasenas de los dos roles de base de datos. NUNCA se escriben en migraciones
# ni en el repo: se aplican con ALTER ROLE ... PASSWORD desde estas variables.
# Ver packages/db/README.md seccion 1.
APP_MIGRATOR_PASSWORD=changeme-migrator
APP_RUNTIME_PASSWORD=changeme-runtime

# ----------------------------------------------------------------------------
# GitHub App
#
# No todos los servicios necesitan todas: apps/webhook solo necesita
# GITHUB_WEBHOOK_SECRET; la clave privada solo la necesita el proceso que llama
# a la API (apps/worker). Ver docs/github-app-setup.md seccion 5.
# ----------------------------------------------------------------------------

# ID numerico de la GitHub App (visible en la pagina de configuracion de la App)
GITHUB_APP_ID=123456

# Clave privada de la GitHub App en formato PEM, codificada en base64 EN UNA SOLA LINEA
# (genera con: base64 -w0 clave-privada.pem)
GITHUB_APP_PRIVATE_KEY=LS0tLS1CRUdJTi...base64...

# Secreto compartido para verificar la firma HMAC de los webhooks entrantes
GITHUB_WEBHOOK_SECRET=changeme-webhook-secret

# Client ID / secret de la GitHub App, usados en el flujo OAuth de usuario (no confundir con la App)
GITHUB_APP_CLIENT_ID=Iv1.changeme
GITHUB_APP_CLIENT_SECRET=changeme-client-secret

# Puerto HTTP donde escucha apps/webhook
WEBHOOK_PORT=3000

# Interfaz donde escucha apps/webhook. 0.0.0.0 para que sea alcanzable desde el
# contenedor/proxy; 127.0.0.1 si delante hay un reverse proxy en la misma maquina.
WEBHOOK_HOST=0.0.0.0

# ----------------------------------------------------------------------------
# Grafo de dependencias (packages/graph, epic 02)
# ----------------------------------------------------------------------------

# Raiz de los checkouts locales que indexa la ingesta del grafo, con la forma
# <raiz>/<owner>/<repo>. Clonar y actualizar esos checkouts NO es todavia
# responsabilidad de este sistema: si esta variable no esta definida, apps/worker
# arranca igual y deja la ingesta del grafo DESACTIVADA, diciendolo en el log.
GRAPH_CHECKOUT_ROOT=/var/lib/coord/checkouts

# Tenant sobre el que responde el SERVIDOR MCP del grafo (packages/graph/src/mcp).
# OBLIGATORIA para ese proceso: sin ella el servidor SE NIEGA A ARRANCAR (sale
# con codigo 1 y lo dice). No se pide como argumento de la llamada a proposito:
# si el tenant fuera un parametro, lo escribiria el LLM y el aislamiento entre
# clientes dependeria de lo que decida un modelo. No la necesitan ni apps/worker
# ni apps/webhook.
GRAPH_MCP_TENANT_ID=00000000-0000-0000-0000-000000000000

# Tenant que usa el comando de indexado manual (`pnpm --filter @coord/graph
# graph:index`). Si no esta, cae a GRAPH_MCP_TENANT_ID, para que el grafo que
# escribe el comando sea el mismo que consulta el servidor MCP. NO tiene valor
# por defecto a proposito: la RLS exige tenant y elegir uno seria el atajo que
# rompe el aislamiento sin que nadie se entere.
GRAPH_TENANT_ID=

# ----------------------------------------------------------------------------
# Tests generados (packages/agents, epic 05 / T02)
# ----------------------------------------------------------------------------

# Clave HMAC con la que se FIRMA `verification/generated-tests.manifest.json`.
#
# NO se pone en el .env de un desarrollador, y por eso aqui va vacia: su valor
# real vive SOLO como secreto del repositorio en GitHub Actions (job
# `generated-tests` de .github/workflows/ci.yml). Ese es todo el punto — si la
# clave estuviera en la maquina donde corre el agente, quien reescriba un test
# generado podria volver a firmar el manifiesto y el gate no se enteraria.
#
# Sin clave, el CLI (`pnpm --filter @coord/agents verify:generated-tests`)
# comprueba los hashes igualmente y AVISA en voz alta de que la firma no se ha
# comprobado. Eso protege del descuido, no de un agente.
#
# Generarla: `openssl rand -hex 32` (o `node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"`)
# y guardarla en Settings > Secrets and variables > Actions > New repository secret,
# con el nombre GENERATED_TESTS_MANIFEST_KEY. Ver docs/runbook.md.
GENERATED_TESTS_MANIFEST_KEY=

# ----------------------------------------------------------------------------
# Tests de integracion (ADR 0007)
# ----------------------------------------------------------------------------
# URL de un Postgres YA EN MARCHA para los tests de integracion.
#
# Si NO la defines, los tests levantan un contenedor por proceso y todo
# funciona igual: `pnpm test` sigue corriendo sobre un checkout limpio sin
# arrancar nada. Definirla solo lo hace mas rapido.
#
# La EXCEPCION es el mutation testing: `pnpm test:mutation` se NIEGA a correr
# sin esta variable, y lo dice con el comando que falta. Un contenedor por
# mutante hace que la puntuacion salga de los timeouts en vez de los tests
# (issue #26): se midieron 90,34 con cero mutantes muertos.
#
#   docker compose -f infra/docker-compose.yml up -d postgres
#   TEST_DATABASE_URL=postgres://<POSTGRES_USER>:<POSTGRES_PASSWORD>@localhost:${POSTGRES_HOST_PORT:-5432}/<POSTGRES_DB>
TEST_DATABASE_URL=
