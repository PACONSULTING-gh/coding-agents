{
  "name": "@coord/agents",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc -p test/tsconfig.json",
    "test": "vitest run",
    "verify:generated-tests": "tsx src/verification/verify-generated-tests-cli.ts",
    "measure:trap-suite": "tsx test/trap-suite-cli.ts",
    "measure:routing": "tsx test/routing-bench-cli.ts",
    "probe:refusal": "tsx test/refusal-probe-cli.ts",
    "probe:once": "tsx test/verifier-once-cli.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "@coord/core": "workspace:*",
    "@coord/db": "workspace:*",
    "@coord/github": "workspace:*",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.1.0",
    "testcontainers": "^12.1.0"
  }
}
