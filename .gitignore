# Skill de diagramas: se instala con ./scripts/install-archify.sh, version
# fijada y checksum comprobado. No se vendoriza (2,5 MB).
.claude/skills/archify/

# Diagramas renderizados: artefacto, como dist/. La fuente es el .json.
# Se regeneran con `pnpm diagrams`.
docs/diagrams/*.html
# Sidecars de `archify visual-check`: capturas y recibo de navegador.
docs/diagrams/*.visual-check.*

# Artefactos de sesiones de Playwright (capturas, snapshots, logs de consola).
.playwright-mcp/
